# Modelo para o SERVIDOR. Copie para ".env" (nesta pasta) e preencha.
# O arquivo .env nao vai para o git.

# Dominio apontado para o IP do servidor (sem https://). Ex.: monitoria.exemplo.com
DOMAIN=troque-pelo-seu-dominio

# Senhas fortes e diferentes entre si (evite $, # e espacos).
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-forte
DB_PASSWORD=troque-por-outra-senha-forte
REDIS_PASSWORD=troque-por-mais-uma-senha-forte

# 32+ caracteres aleatorios. Fixa, senao todos caem no login a cada reinicio.
JWT_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres

# Opcionais:
# DDL_AUTO=update   (depois da primeira subida pode trocar para validate)
# JAVA_OPTS=-Xmx512m

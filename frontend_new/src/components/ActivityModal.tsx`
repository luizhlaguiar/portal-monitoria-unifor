import React from 'react';
import { Modal, Form, Row, Col, Button } from 'react-bootstrap';

interface ActivityModalProps {
  show: boolean;
  onHide: () => void;
  newActivity: {
    titulo: string;
    prazo: string;
    descricao: string;
    noDeadline: boolean;
    arquivoUrl: string;
  };
  setNewActivity: React.Dispatch<React.SetStateAction<any>>;
  handleAddActivity: (e: React.FormEvent) => Promise<void>;
  handleActivityFileUpload: (e: React.ChangeEvent<HTMLInputElement>) => Promise<void>;
  uploadingActivityFile: boolean;
}

const ActivityModal: React.FC<ActivityModalProps> = ({
  show,
  onHide,
  newActivity,
  setNewActivity,
  handleAddActivity,
  handleActivityFileUpload,
  uploadingActivityFile
}) => {
  console.log('ActivityModal rendering. Show:', show);

  return (
    <Modal show={show} onHide={onHide} centered>
      <Modal.Header closeButton>
        <Modal.Title className="fw-bold">Nova Atividade de Fixação</Modal.Title>
      </Modal.Header>
      <Modal.Body>
        <Form id="activity-form" onSubmit={handleAddActivity}>
          <Form.Group className="mb-3">
            <Form.Label className="small fw-bold">Título</Form.Label>
            <Form.Control
              type="text"
              value={newActivity.titulo}
              onChange={e => setNewActivity({...newActivity, titulo: e.target.value})}
              required
            />
          </Form.Group>
          <Form.Group className="mb-3">
            <Form.Label className="small fw-bold">Prazo</Form.Label>
            <Row>
              <Col>
                <Form.Control
                  type="date"
                  value={newActivity.prazo}
                  onChange={e => setNewActivity({...newActivity, prazo: e.target.value, noDeadline: false})}
                />
              </Col>
              <Col xs="auto" className="d-flex align-items-center">
                <Form.Check
                  type="checkbox"
                  label="Sem prazo"
                  checked={newActivity.noDeadline}
                  onChange={e => setNewActivity({...newActivity, noDeadline: e.target.checked})}
                />
              </Col>
            </Row>
          </Form.Group>
          <Form.Group className="mb-3">
            <Form.Label className="small fw-bold">Descrição</Form.Label>
            <Form.Control
              as="textarea"
              rows={3}
              value={newActivity.descricao}
              onChange={e => setNewActivity({...newActivity, descricao: e.target.value})}
              required
            />
          </Form.Group>
          <Form.Group className="mb-3">
            <Form.Label className="small fw-bold">Anexo (Opcional)</Form.Label>
            <Form.Control
              type="file"
              onChange={handleActivityFileUpload}
              disabled={uploadingActivityFile}
            />
            {uploadingActivityFile && <small className="text-primary">Enviando arquivo...</small>}
            {newActivity.arquivoUrl && <small className="text-success">Arquivo anexado com sucesso!</small>}
          </Form.Group>
        </Form>
      </Modal.Body>
      <Modal.Footer>
        <Button variant="secondary" onClick={onHide}>Cancelar</Button>
        <Button type="submit" form="activity-form" variant="dark" disabled={uploadingActivityFile}>Salvar Atividade</Button>
      </Modal.Footer>
    </Modal>
  );
};

export default ActivityModal;
